                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />
                <ImageView
                    android:id="@+id/widget_label_7"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />
                <ImageView
                    android:id="@+id/widget_label_8"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />
                <ImageView
                    android:id="@+id/widget_label_9"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />
                <ImageView
                    android:id="@+id/widget_label_10"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />
                <ImageView
                    android:id="@+id/widget_label_11"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />
                <ImageView
