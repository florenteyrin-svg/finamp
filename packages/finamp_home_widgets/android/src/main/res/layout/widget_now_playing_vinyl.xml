<?xml version="1.0" encoding="utf-8"?>
<!-- "Vinyle" model: a record that spins while playing, the album art as its label -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_outline"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shape" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <FrameLayout
            android:layout_width="112dp"
            android:layout_height="112dp">

            <ProgressBar
                android:id="@+id/widget_vinyl_spinning"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="true"
                android:indeterminateDrawable="@drawable/widget_vinyl_rotating"
                android:indeterminateDuration="1800"
                android:indeterminateOnly="true"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/widget_vinyl_still"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_vinyl" />

            <ImageView
                android:id="@+id/widget_art"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/widget_ic_music" />

            <!-- While playing: the label turned a bit more in each frame, flipped in step with the record
                 (45 frames x 40 ms = one turn in 1.8 s, like the grooves: 25 frames per second) -->
            <ViewFlipper
                android:id="@+id/widget_label_spinning"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:autoStart="true"
                android:flipInterval="40"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/widget_label_0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />
                <ImageView
                    android:id="@+id/widget_label_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />
                <ImageView
                    android:id="@+id/widget_label_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />
                <ImageView
                    android:id="@+id/widget_label_3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />
                <ImageView
                    android:id="@+id/widget_label_4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />
                <ImageView
                    android:id="@+id/widget_label_5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />
                <ImageView
                    android:id="@+id/widget_label_6"
